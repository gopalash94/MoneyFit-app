    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~7.0.0",
    "react": "19.2.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.29.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.19.0",
    "react-native-svg": "15.14.0",
    "react-native-webview": "13.16.0",
