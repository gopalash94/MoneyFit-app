    "install-deps": "expo install expo-router expo-sqlite expo-file-system expo-image-picker expo-document-picker expo-secure-store expo-crypto expo-sharing expo-constants expo-linking expo-status-bar expo-system-ui expo-asset react-native-svg react-native-safe-area-context react-native-screens react-native-gesture-handler react-native-webview",
    "bundle-pdfjs": "node scripts/bundle-pdfjs.mjs",
    "postinstall": "node scripts/bundle-pdfjs.mjs"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-asset": "~12.0.0",
    "expo-constants": "~19.0.0",
    "expo-crypto": "~16.0.0",
    "expo-document-picker": "~15.0.0",
    "expo-file-system": "~20.0.0",
    "expo-image-picker": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~7.0.0",
    "expo-secure-store": "~16.0.0",
    "expo-sharing": "~15.0.0",
